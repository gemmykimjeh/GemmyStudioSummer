+    def _build_agent(self, instance: EvalInstance) -> "Agent | ACPAgent":
+        """Construct the agent for one instance.
+
+        Split out of ``evaluate_instance`` so subclasses can attach an
+        ``AgentContext`` (or otherwise adjust the agent) without duplicating the
+        tool, MCP and condenser configuration.
+        """
+        if is_acp_agent(self.metadata.agent_type):
+            return build_acp_agent(self.metadata.agent_type, self.metadata.llm.model)
+
+        tools = get_default_tools(enable_browser=True)
+        if self.metadata.enable_delegation:
+            tools.append(Tool(name=DelegateTool.name))
+        tavily_api_key = os.getenv("TAVILY_API_KEY", "")
+        assert tavily_api_key, "TAVILY_API_KEY environment variable is not set"
+        condenser = None
+        if self.metadata.enable_condenser:
+            condenser = LLMSummarizingCondenser(
+                llm=self.metadata.llm.model_copy(update={"usage_id": "condenser"}),
+                max_size=self.metadata.condenser_max_size,
+                keep_first=self.metadata.condenser_keep_first,
+            )
+        return Agent(
+            llm=self.metadata.llm,
+            tools=tools,
+            system_prompt_kwargs={"cli_mode": True},
+            condenser=condenser,
+            mcp_config={
+                "mcpServers": {
+                    "fetch": {"command": "uvx", "args": ["mcp-server-fetch"]},
+                    "tavily": {
+                        "command": "npx",
+                        "args": ["-y", "tavily-mcp@0.2.1"],
+                        "env": {"TAVILY_API_KEY": tavily_api_key},
+                    },
+                }
+            },
+        )
+
