# Copy to configs/gemini_keys.env (that filename is gitignored) and fill in your
# real Gemini free-tier keys from https://aistudio.google.com/apikey
#
# The proxy (scripts/start_proxy.sh) sources this file and round-robins requests
# across every key that is set. GEMINI_KEY_2 / _3 are optional — if unset they
# fall back to GEMINI_KEY_1, so a single key works fine.

GEMINI_KEY_1=your-first-gemini-key
GEMINI_KEY_2=your-second-gemini-key
GEMINI_KEY_3=your-third-gemini-key
