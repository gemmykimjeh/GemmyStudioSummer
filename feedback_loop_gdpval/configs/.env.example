# ---- Gemini free-tier keys (rotate to survive RPM limits) -------------------
# Put 3-4 free keys from https://aistudio.google.com/apikey here, comma-separated.
GEMINI_API_KEYS=key_one,key_two,key_three,key_four

# The grader talks Anthropic-SDK -> LiteLLM proxy on :4000 (started separately).
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-proxy

# Optional tuning
# RGR_MODE=a3              # a0|a1|a2|a3 (script sets this; env overrides)
# RGR_GUARDRAIL_K=2        # failures before a guardrail activates
# GEMINI_KEY_COOLDOWN=65   # seconds to park a key after a 429
