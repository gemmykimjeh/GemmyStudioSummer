# ============================================================================
# GemmyStudioSummer — 통합 환경변수 템플릿
# 복사: cp .env.example .env  (루트에 .env 하나만 두면 됨; 각 하위 폴더의
#   ReAct/.env · ReAct_feedback_loop/.env · test_benchmark/.env 는 이 루트
#   .env 를 가리키는 하드링크라서 자동으로 같은 값을 공유함.)
# .env 는 .gitignore 로 커밋에서 제외됨 — 실제 키를 절대 커밋하지 말 것.
# ============================================================================

# --- 모델 / 저지 키 -----------------------------------------------------------
# ace(Generator/Reflector/Curator), claude_sdk 에이전트, BrowseComp, GDPval 저지:
ANTHROPIC_API_KEY=sk-ant-...
# tau-bench 기본 user-simulator(gpt-4o via litellm):
OPENAI_API_KEY=sk-...
# 선택: HuggingFace 데이터셋(SWE-bench, GDPval) 다운로드 가속:
# HF_TOKEN=hf_...

# --- 인프라 엔드포인트 (무거운 벤치에서만) ------------------------------------
# swe_bench / terminal_bench 용 원격 Docker (없으면 로컬 데몬 사용):
# DOCKER_HOST=tcp://HOST:2375
# 실행 중인 OSWorld desktop VM 의 in-VM 서버(host[:5000]):
# OSWORLD_ENDPOINT=192.168.1.50:5000

# --- 외부 repo / 경로 오버라이드 (기본값: external/<repo>) ---------------------
# TAU_BENCH_PATH=external/tau-bench
# AUTOMATION_BENCH_PATH=external/AutomationBench
# TERMINAL_BENCH_TASKS=external/terminal-bench/original-tasks
# OSWORLD_PATH=external/OSWorld
# HERMES_PATH=C:/hermes
